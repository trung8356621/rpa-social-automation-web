# Staff API mode for Action Tags (CP9A). Default mock.
# Other four routes remain mock regardless.
VITE_RPA_API_MODE=mock

# Optional absolute API origin. Leave EMPTY for local DEV (uses Vite proxy → same-origin).
# Setting https://seo-ops.duckdns.org causes browser CORS "Failed to fetch" from :5173
# (production CORS allowlist is not localhost:5173) and SameSite=Lax cookies will not attach.
# VITE_RPA_API_BASE=

# DEV-only Vite proxy target (vite.config.ts). Not embedded in the browser bundle.
# VITE_RPA_DEV_PROXY_TARGET=https://seo-ops.duckdns.org
